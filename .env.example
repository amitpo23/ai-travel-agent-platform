# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_travel_agent

# Authentication & Security
JWT_SECRET=your-secret-key-here
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://your-oauth-server.com
OWNER_OPEN_ID=your-owner-open-id

# LLM / Forge API (for chat functionality)
BUILT_IN_FORGE_API_URL=https://api.openai.com/v1
BUILT_IN_FORGE_API_KEY=your-openai-api-key

# Medici Hotels API
# Get these from your Medici Hotels API account
MEDICI_API_TOKEN=your-medici-api-token-here
MEDICI_CLIENT_SECRET=your-medici-client-secret-here

# Server Configuration
NODE_ENV=development
PORT=3000
